# Copie para .env.local se for rodar scripts/publish-news.sh na sua máquina.
# NUNCA faça commit de um arquivo .env com valores reais (.env* já está no .gitignore).
#
# O site em si não precisa de nenhuma variável — ele é 100% estático.

# Token fine-grained do GitHub, com acesso só a este repositório
# e permissão "Contents: Read and write".
GITHUB_TOKEN=

# Opcionais (valores padrão abaixo)
GITHUB_REPOSITORY=robertourias/nico-noticias
GITHUB_BRANCH=main
